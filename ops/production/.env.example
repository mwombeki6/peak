PEAK_IMAGE=ghcr.io/mwombeki6/peak/peak:CHANGE_ME
PEAK_PUBLIC_HOST=api.peak.example.com
PEAK_APP_ORIGIN=https://app.peak.example.com

POSTGRES_DB=peak
POSTGRES_MIGRATOR_USER=peak_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_APP_USER=peak_app
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_WORKER_USER=peak_worker
POSTGRES_WORKER_PASSWORD=change-me-worker
POSTGRES_PLATFORM_SUPPORT_PASSWORD=change-me-platform-support

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_HOSTNAME=auth.peak.example.com

PEAK_SECURITY_JWT_ISSUER_URI=https://auth.peak.example.com/realms/peak
PEAK_SECURITY_JWT_AUDIENCE=peak-api
PEAK_CORS_ALLOWED_ORIGINS=https://app.peak.example.com
PEAK_ALLOW_HEADER_IDENTITY=false
PEAK_ALLOW_TRUSTED_JWT_IDENTITY_CLAIMS=false
PEAK_DB_POOL_MAX_SIZE=20
PEAK_DB_POOL_MIN_IDLE=5
PEAK_WORKER_DB_POOL_MAX_SIZE=10
PEAK_WORKER_DB_POOL_MIN_IDLE=2
PEAK_MIGRATION_DB_POOL_MAX_SIZE=2
PEAK_MIGRATION_DB_POOL_MIN_IDLE=0
PEAK_OUTBOX_WORKER_BATCH_SIZE=50
PEAK_OUTBOX_WORKER_MAX_PARALLELISM=4
PEAK_PAYMENT_VODACOM_MPESA_URL=https://payments.example.com/vodacom-mpesa
PEAK_PAYMENT_VODACOM_MPESA_API_KEY=change-me-vodacom-api-key
PEAK_PAYMENT_VODACOM_MPESA_API_SECRET=change-me-vodacom-api-secret

PEAK_OTLP_METRICS_EXPORT_ENABLED=false
PEAK_OTLP_LOGGING_EXPORT_ENABLED=false
PEAK_OTLP_TRACING_EXPORT_ENABLED=false
