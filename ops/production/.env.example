PEAK_IMAGE=ghcr.io/mwombeki6/peak/peak:CHANGE_ME
PEAK_PUBLIC_HOST=api.peak.example.com
PEAK_APP_ORIGIN=https://app.peak.example.com
PEAK_API_BIND_ADDRESS=127.0.0.1
KEYCLOAK_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=peak
POSTGRES_MIGRATOR_USER=peak_migrator
POSTGRES_MIGRATOR_PASSWORD=change-me-migrator
POSTGRES_APP_USER=peak_app
POSTGRES_APP_PASSWORD=change-me-app
POSTGRES_WORKER_USER=peak_worker
POSTGRES_WORKER_PASSWORD=change-me-worker
POSTGRES_PLATFORM_SUPPORT_PASSWORD=change-me-platform-support

KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_HOSTNAME=auth.peak.example.com

PEAK_SECURITY_JWT_ISSUER_URI=https://auth.peak.example.com/realms/peak
PEAK_SECURITY_JWT_AUDIENCE=peak-api
PEAK_CORS_ALLOWED_ORIGINS=https://app.peak.example.com
PEAK_REALTIME_WEBSOCKET_ALLOWED_ORIGINS=https://app.peak.example.com
PEAK_ALLOW_HEADER_IDENTITY=false
PEAK_ALLOW_TRUSTED_JWT_IDENTITY_CLAIMS=false
PEAK_COMMUNICATION_DELIVERY_LOCAL_PROVIDER_ENABLED=false
PEAK_COMMUNICATION_DELIVERY_HTTP_PROVIDER_ENABLED=true
PEAK_COMMUNICATION_DELIVERY_HTTP_PROVIDER_BASE_URL=https://communications.example.com
PEAK_COMMUNICATION_DELIVERY_HTTP_PROVIDER_API_KEY=change-me-communication-provider-key
PEAK_INVITATION_ACCEPTANCE_BASE_URL=https://app.peak.example.com/invitations/accept
PEAK_ENVELOPE_KEY_REFERENCE=env:PEAK_ENVELOPE_KEY_BASE64
PEAK_ENVELOPE_KEY_BASE64=change-me-base64-encoded-32-byte-envelope-key
PEAK_ENVELOPE_PREVIOUS_KEY_REFERENCE=
PEAK_ENVELOPE_PREVIOUS_KEY_BASE64=
PEAK_PAYMENT_GATEWAY_CREDENTIAL=change-me-payment-gateway-credential
PEAK_PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret
PEAK_CLICKPESA_API_KEY=change-me-clickpesa-api-key
PEAK_CLICKPESA_CHECKSUM_KEY=change-me-clickpesa-checksum-key
PEAK_PAYMENT_PRODUCTION_APPROVED_PROVIDER_CODES=clickpesa
PEAK_FISCAL_PRODUCTION_APPROVED_PROVIDER_CODES=
PEAK_FISCAL_GATEWAY_CREDENTIAL=change-me-fiscal-gateway-credential
PEAK_OUTBOUND_PROVIDER_ALLOWED_HOSTS=api.clickpesa.com,fiscal.example.com
PEAK_ACCEPTANCE_MODE=false
PEAK_PLATFORM_BOOTSTRAP_ENABLED=false
PEAK_PLATFORM_RECOVERY_ENABLED=false
PEAK_PLATFORM_BOOTSTRAP_FULL_NAME=
PEAK_PLATFORM_BOOTSTRAP_EMAIL=
PEAK_PLATFORM_BOOTSTRAP_ISSUER=
PEAK_PLATFORM_BOOTSTRAP_SUBJECT=
PEAK_DB_POOL_MAX_SIZE=20
PEAK_DB_POOL_MIN_IDLE=5
PEAK_DB_CONNECTION_TIMEOUT=5000
PEAK_DB_VALIDATION_TIMEOUT=2000
PEAK_DB_IDLE_TIMEOUT=600000
PEAK_DB_MAX_LIFETIME=1800000
PEAK_WORKER_DB_POOL_MAX_SIZE=10
PEAK_WORKER_DB_POOL_MIN_IDLE=2
PEAK_MIGRATION_DB_POOL_MAX_SIZE=2
PEAK_MIGRATION_DB_POOL_MIN_IDLE=0
PEAK_OUTBOX_WORKER_BATCH_SIZE=50
PEAK_OUTBOX_WORKER_MAX_PARALLELISM=4
PEAK_GUEST_IDENTITY_HASH_KEY=change-me-guest-identity-hmac-key-at-least-32-characters
PEAK_GUEST_IDENTITY_HASH_KEY_VERSION=v1
PEAK_GUEST_IDENTITY_PREVIOUS_HASH_KEY=
PEAK_GUEST_IDENTITY_PREVIOUS_HASH_KEY_VERSION=
PEAK_NIDA_MODE=disabled
PEAK_NIDA_BASE_URL=
PEAK_NIDA_CLIENT_ID=
PEAK_NIDA_CLIENT_SECRET=
PEAK_NIDA_CONNECT_TIMEOUT=3s
PEAK_NIDA_READ_TIMEOUT=8s
PEAK_REPORT_STORAGE_ENABLED=true
PEAK_REPORT_STORAGE_ENDPOINT=https://s3.example.com
PEAK_REPORT_STORAGE_ACCESS_KEY=change-me-report-storage-access-key
PEAK_REPORT_STORAGE_SECRET_KEY=change-me-report-storage-secret-key
PEAK_REPORT_STORAGE_BUCKET=peak-private-reports
PEAK_REPORT_STORAGE_REGION=us-east-1

PEAK_OTLP_METRICS_EXPORT_ENABLED=false
PEAK_OTLP_LOGGING_EXPORT_ENABLED=false
PEAK_OTLP_TRACING_EXPORT_ENABLED=false
