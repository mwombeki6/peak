{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "type": "timeseries",
      "title": "Report generation outcomes",
      "targets": [
        {
          "expr": "sum by (report_code, result) (rate(peak_reporting_generation_total[5m]))",
          "legendFormat": "{{report_code}} {{result}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Report delivery outcomes",
      "targets": [
        {
          "expr": "sum by (channel, result) (rate(peak_reporting_delivery_total[5m]))",
          "legendFormat": "{{channel}} {{result}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Storage errors",
      "targets": [
        {
          "expr": "sum(increase(peak_reporting_storage_errors_total[1h]))",
          "legendFormat": "errors"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 }
    },
    {
      "type": "stat",
      "title": "Expired artifacts cleaned",
      "targets": [
        {
          "expr": "sum(increase(peak_reporting_artifacts_expired_total[24h]))",
          "legendFormat": "objects"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Report outbox retries",
      "targets": [
        {
          "expr": "sum(rate(peak_outbox_worker_failed_total{destination=\"reports\"}[5m]))",
          "legendFormat": "failed"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 }
    }
  ],
  "schemaVersion": 39,
  "tags": ["peak", "reporting", "close"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Peak Close and Reporting",
  "uid": "peak-control-close-reporting",
  "version": 1
