{
  "info": {
    "_postman_id": "ac5e82ab-c786-4d67-a78f-6f463cc91d4f",
    "name": "Peak Phase 3 End-to-End",
    "description": "Authenticated Phase 3 stay lifecycle. Run Phase 2 setup first and provide property resource ids. Contract mocks are local/test only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 Runtime Gate",
      "item": [
        {
          "name": "Readiness",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{baseUrl}}/actuator/health/readiness"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('runtime is ready', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Phase 3 Module Activation",
      "description": "Enable every Phase 3 module at tenant and property scope. These commands are idempotent and remove any manual SQL prerequisite.",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('module activation succeeded', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Enable Tenant Reservations",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-tenant-{{tenantId}}-reservations" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"reservations\"}" },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Enable Tenant Front Desk",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-tenant-{{tenantId}}-frontdesk" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"frontdesk\"}" },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Enable Tenant Billing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-tenant-{{tenantId}}-billing" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"billing\"}" },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Enable Tenant Payments",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-tenant-{{tenantId}}-payments" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"payments\"}" },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Enable Tenant Fiscal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-tenant-{{tenantId}}-fiscal" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"fiscal\"}" },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Enable Tenant Night Audit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-tenant-{{tenantId}}-night-audit" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"night_audit\"}" },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Enable Property Reservations",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-property-{{propertyId}}-reservations" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"reservations\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/modules"
          }
        },
        {
          "name": "Enable Property Front Desk",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-property-{{propertyId}}-frontdesk" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"frontdesk\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/modules"
          }
        },
        {
          "name": "Enable Property Billing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-property-{{propertyId}}-billing" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"billing\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/modules"
          }
        },
        {
          "name": "Enable Property Payments",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-property-{{propertyId}}-payments" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"payments\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/modules"
          }
        },
        {
          "name": "Enable Property Fiscal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-property-{{propertyId}}-fiscal" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"fiscal\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/modules"
          }
        },
        {
          "name": "Enable Property Night Audit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "phase3-property-{{propertyId}}-night-audit" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"night_audit\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/modules"
          }
        }
      ]
    },
    {
      "name": "02 Guest Identity",
      "item": [
        {
          "name": "Create Adult Guest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "guest-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Phase 3 Guest {{runId}}\",\n  \"email\": \"phase3-{{runId}}@example.test\",\n  \"phonePrimary\": \"+255712345678\",\n  \"dateOfBirth\": \"1990-01-15\",\n  \"nationality\": \"TZ\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/guests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.collectionVariables.set('guestId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Attest Physical Identity",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "identity-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"NIDA\",\n  \"documentNumber\": \"19900115-12345-00001-01\",\n  \"issuingCountry\": \"TZ\",\n  \"issuingAuthority\": \"NIDA\",\n  \"attestationReason\": \"Original physical card inspected during Phase 3 acceptance\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/guests/{{guestId}}/identity-documents/manual-verification"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.expect(body.document.verificationStatus).to.eql('VERIFIED');",
                  "pm.expect(body.document.maskedDocumentNumber).not.to.include('19900115-12345-00001-01');",
                  "pm.collectionVariables.set('identityDocumentId', body.document.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Reservation And Check-In",
      "item": [
        {
          "name": "Create Confirmed Reservation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "reservation-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primaryGuestId\": \"{{guestId}}\",\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"roomId\": \"{{roomId}}\",\n  \"checkInDate\": \"{{checkInDate}}\",\n  \"checkOutDate\": \"{{checkOutDate}}\",\n  \"adults\": 1,\n  \"children\": 0,\n  \"ratePerNight\": 100000.00\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/reservations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('reservationId', body.reservationId);",
                  "pm.collectionVariables.set('folioId', body.folioId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Reservation Identity Readiness",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/reservations/{{reservationId}}/identity-readiness"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().ready).to.eql(true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Check In",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "checkin-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservationId\": \"{{reservationId}}\",\n  \"roomId\": \"{{roomId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/checkins"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('stayId', body.stayId);",
                  "pm.collectionVariables.set('folioId', body.folioId);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Billing And Cash",
      "item": [
        {
          "name": "Post Folio Charge",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "charge-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chargeType\": \"ROOM\",\n  \"description\": \"Phase 3 room charge\",\n  \"revenueCenterId\": \"{{revenueCenterId}}\",\n  \"quantity\": 1,\n  \"unitPrice\": 200000.00,\n  \"taxRate\": 18.00\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/folios/{{folioId}}/charges"
          }
        },
        {
          "name": "Read Folio Balance",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/folios/{{folioId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.expect(Number(body.balanceDue)).to.be.above(0);",
                  "pm.collectionVariables.set('folioBalance', body.balanceDue);"
                ]
              }
            }
          ]
        },
        {
          "name": "Open Cash Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "cash-session-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"openingFloat\": 50000.00,\n  \"notes\": \"Phase 3 acceptance\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/payments/cash-sessions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.collectionVariables.set('cashSessionId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Collect Cash",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "cash-payment-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"folioId\": \"{{folioId}}\",\n  \"cashSessionId\": \"{{cashSessionId}}\",\n  \"amount\": {{folioBalance}},\n  \"notes\": \"Full cash settlement\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/payments/cash"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.expect(body.status).to.eql('confirmed');",
                  "pm.collectionVariables.set('paymentTransactionId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read Current Cash Session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/payments/cash-sessions/current"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.collectionVariables.set('expectedCash', pm.response.json().expectedCash);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Fiscal And Checkout",
      "item": [
        {
          "name": "Configure Local Fiscal Contract Adapter",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "fiscal-config-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"providerCode\": \"contract_mock\",\n  \"providerName\": \"Local Fiscal Contract\",\n  \"authorityName\": \"Tanzania Revenue Authority\",\n  \"environment\": \"sandbox\",\n  \"endpointUrl\": \"https://fiscal.invalid/v1/receipts\",\n  \"secretRef\": \"literal:phase3-fiscal-test-secret\",\n  \"taxpayerIdentifier\": \"123-456-789\",\n  \"isDefault\": true\n}"
            },
            "description": "Local/test profile only. Use http_gateway and env-backed secrets in staging/production.",
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/fiscal/provider-configs"
          }
        },
        {
          "name": "Issue Invoice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "invoice-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dueDateDays\": 0\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/folios/{{folioId}}/invoice"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.collectionVariables.set('invoiceId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll Fiscal Receipt",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/fiscal/receipts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const receipt = pm.response.json().find(r => r.invoiceId === pm.collectionVariables.get('invoiceId'));",
                  "pm.expect(receipt, 'worker has produced fiscal receipt').to.exist;",
                  "pm.expect(receipt.status).to.eql('accepted');",
                  "pm.collectionVariables.set('fiscalReceiptId', receipt.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Close Cash Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "cash-close-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actualCash\": {{expectedCash}},\n  \"notes\": \"Phase 3 counted cash\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/payments/cash-sessions/{{cashSessionId}}/close"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().variance).to.eql(0);"
                ]
              }
            }
          ]
        },
        {
          "name": "Normal Checkout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "checkout-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Phase 3 acceptance complete\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/checkouts/{{stayId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "pm.expect(pm.response.json().status).to.eql('checked_out');"
                ]
              }
            }
          ]
        },
        {
          "name": "Run Night Audit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "night-audit-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/night-audit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const body = pm.response.json();",
                  "pm.expect(body.status).to.eql('completed');",
                  "pm.collectionVariables.set('nightAuditRunId', body.id);"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "runId", "value": "replace-with-unique-suffix" },
    { "key": "tenantId", "value": "" },
    { "key": "propertyId", "value": "" },
    { "key": "roomTypeId", "value": "" },
    { "key": "roomId", "value": "" },
    { "key": "revenueCenterId", "value": "" },
    { "key": "checkInDate", "value": "2026-12-01" },
    { "key": "checkOutDate", "value": "2026-12-03" },
    { "key": "guestId", "value": "" },
    { "key": "identityDocumentId", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "folioId", "value": "" },
    { "key": "stayId", "value": "" },
    { "key": "folioBalance", "value": "" },
    { "key": "cashSessionId", "value": "" },
    { "key": "expectedCash", "value": "" },
    { "key": "paymentTransactionId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "fiscalReceiptId", "value": "" },
    { "key": "nightAuditRunId", "value": "" }
  ]
}
