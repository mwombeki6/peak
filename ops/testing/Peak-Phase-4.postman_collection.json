{
  "info": {
    "_postman_id": "d4e2b284-cafd-47d2-89b8-26c5e6832de4",
    "name": "Peak Phase 4 Department Operations",
    "description": "API-only acceptance for housekeeping settings, weighted-average inventory, recipes, replay-safe kitchen sends, and KDS evidence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({key: 'X-Correlation-Id', value: 'phase4-' + pm.variables.replaceIn('{{$guid}}')});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Configure inspected housekeeping",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-hk-settings-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"inspectionRequired\":true,\"stayoverEnabled\":true,\"stayoverIntervalDays\":3,\"turnoverMinutes\":45}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/housekeeping/settings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('inspection is required', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().inspectionRequired).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create kitchen inventory location",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-location-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Acceptance Kitchen {{runId}}\",\"type\":\"kitchen\",\"outletId\":\"{{outletId}}\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/inventory/locations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('location created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('locationId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create inventory item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-item-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Acceptance Ingredient {{runId}}\",\"sku\":\"ACC-{{runId}}\",\"category\":\"Food\",\"unit\":\"kg\",\"reorderLevel\":2}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/inventory/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('item created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('inventoryItemId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Post opening balance",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-opening-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"lines\":[{\"inventoryItemId\":\"{{inventoryItemId}}\",\"locationId\":\"{{locationId}}\",\"quantity\":10,\"unitCost\":5000}],\"reason\":\"Acceptance opening balance\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/inventory/opening-balances"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('opening balance posted once', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().movements).to.have.length(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Configure menu recipe",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-recipe-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"menuItemId\":\"{{menuItemId}}\",\"components\":[{\"inventoryItemId\":\"{{inventoryItemId}}\",\"locationId\":\"{{locationId}}\",\"quantity\":0.5,\"unit\":\"kg\"}]}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/inventory/recipes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('recipe configured', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Open POS session",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-session-{{runId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"outletId\":\"{{outletId}}\",\"openingFloat\":0}" },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/pos-sessions/open"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('session opened', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('sessionId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Create offline-safe POS order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-order-http-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"sessionId\":\"{{sessionId}}\",\"orderType\":\"dine_in\",\"clientOperationId\":\"phase4-order-op-{{runId}}\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/pos-orders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('order created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('orderId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Add offline-safe order item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-add-http-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"menuItemId\":\"{{menuItemId}}\",\"quantity\":2,\"clientOperationId\":\"phase4-add-op-{{runId}}\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/pos-orders/{{orderId}}/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('item added', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Send order to kitchen",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-send-http-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"clientOperationId\":\"phase4-send-op-{{runId}}\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/pos-orders/{{orderId}}/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('ticket created', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('ticketId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Replay kitchen send",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "phase4-send-http-{{runId}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"clientOperationId\":\"phase4-send-op-{{runId}}\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/pos-orders/{{orderId}}/send"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('send replay is stable', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('ticketId')); pm.expect(pm.response.json().replayed).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Capture KDS evidence",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/kitchen-tickets"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('KDS contains ticket', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().some(x => x.id === pm.collectionVariables.get('ticketId'))).to.eql(true); });"
            ]
          }
        }
      ]
    }
  ]
}
