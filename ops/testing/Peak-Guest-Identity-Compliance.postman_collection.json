{
  "info": {
    "_postman_id": "2c97a174-a2a5-4eef-9176-5c0f4d6fe7a3",
    "name": "Peak Guest Identity Compliance",
    "description": "Guest registration, identity verification, reservation occupants, readiness, and check-in enforcement. Use synthetic identity numbers only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "accessToken", "value": ""},
    {"key": "propertyId", "value": ""},
    {"key": "guestId", "value": ""},
    {"key": "documentId", "value": ""},
    {"key": "reservationId", "value": ""},
    {"key": "additionalGuestId", "value": ""},
    {"key": "roomTypeId", "value": ""},
    {"key": "roomId", "value": ""}
  ],
  "item": [
    {
      "name": "1. Create adult guest",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "{{$guid}}"},
          {"key": "X-Correlation-Id", "value": "{{$guid}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"fullName\":\"Synthetic Compliance Guest\",\"dateOfBirth\":\"1990-01-01\",\"nationality\":\"TZ\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/guests"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('guest created', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('guestId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Manual physical identity verification",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "{{$guid}}"},
          {"key": "X-Correlation-Id", "value": "{{$guid}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"documentType\":\"NIDA\",\"documentNumber\":\"19900101123456781234\",\"issuingCountry\":\"TZ\",\"attestationReason\":\"Synthetic physical NIDA inspected during E2E test\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/guests/{{guestId}}/identity-documents/manual-verification"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('identity verified', () => pm.expect(pm.response.json().document.verificationStatus).to.eql('VERIFIED'));",
              "pm.test('number masked', () => pm.expect(pm.response.json().document.maskedDocumentNumber).to.match(/^\\*\\*\\*/));",
              "pm.collectionVariables.set('documentId', pm.response.json().document.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. List masked identity metadata",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-Correlation-Id", "value": "{{$guid}}"}
        ],
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/guests/{{guestId}}/identity-documents"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('documents returned', () => pm.response.to.have.status(200));",
              "pm.test('raw number absent', () => pm.expect(pm.response.text()).not.to.include('19900101123456781234'));"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Add reservation occupant",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "{{$guid}}"},
          {"key": "X-Correlation-Id", "value": "{{$guid}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"guestId\":\"{{additionalGuestId}}\",\"relationship\":\"ADULT\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/reservations/{{reservationId}}/guests"
      }
    },
    {
      "name": "5. Reservation identity readiness",
      "request": {
        "method": "GET",
        "header": [
          {"key": "X-Correlation-Id", "value": "{{$guid}}"}
        ],
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/reservations/{{reservationId}}/identity-readiness"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('readiness evaluated', () => pm.response.to.have.status(200));",
              "pm.test('all occupants represented', () => pm.expect(pm.response.json().occupants).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Check in only when identity-ready",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "{{$guid}}"},
          {"key": "X-Correlation-Id", "value": "{{$guid}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"reservationId\":\"{{reservationId}}\",\"roomId\":\"{{roomId}}\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/checkins"
      }
    },
    {
      "name": "7. Revoke identity",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "{{$guid}}"},
          {"key": "X-Correlation-Id", "value": "{{$guid}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"reason\":\"Synthetic revocation test\"}"
        },
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/guests/{{guestId}}/identity-documents/{{documentId}}/revoke"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('identity revoked', () => pm.expect(pm.response.json().verificationStatus).to.eql('REVOKED'));"
            ]
          }
        }
      ]
    }
  ]
}
