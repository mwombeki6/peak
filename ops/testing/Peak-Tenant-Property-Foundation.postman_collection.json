{
  "info": {
    "_postman_id": "6fdc4304-8b68-4eb9-9d42-9ebf29cc70a2",
    "name": "Peak Tenant and Property Foundation",
    "description": "Production-like setup through Keycloak and Peak APIs. Run the platform bootstrap first. No application SQL is required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{platformToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('correlationId', pm.variables.replaceIn('phase2-postman-{{$guid}}'));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8081" },
    { "key": "realm", "value": "peak" },
    { "key": "clientId", "value": "peak-acceptance" },
    { "key": "platformUsername", "value": "phase2-platform-root" },
    { "key": "platformPassword", "value": "" },
    { "key": "tenantUsername", "value": "phase2-tenant-admin" },
    { "key": "tenantPassword", "value": "" },
    { "key": "platformToken", "value": "" },
    { "key": "tenantToken", "value": "" },
    { "key": "tenantSubject", "value": "" },
    { "key": "planId", "value": "20202020-0000-0000-0000-000000000001" },
    { "key": "tenantId", "value": "" },
    { "key": "propertyId", "value": "" },
    { "key": "buildingId", "value": "" },
    { "key": "roomTypeId", "value": "" },
    { "key": "roomId", "value": "" },
    { "key": "contactId", "value": "" },
    { "key": "channelId", "value": "" },
    { "key": "verificationToken", "value": "" },
    { "key": "deliveryRequestId", "value": "" },
    { "key": "contactEmail", "value": "director.postman@example.com" },
    { "key": "correlationId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Platform token",
          "auth": { "type": "noauth" },
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "username", "value": "{{platformUsername}}", "type": "text" },
                { "key": "password", "value": "{{platformPassword}}", "type": "text" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('platformToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Tenant token and subject",
          "auth": { "type": "noauth" },
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "username", "value": "{{tenantUsername}}", "type": "text" },
                { "key": "password", "value": "{{tenantPassword}}", "type": "text" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('token issued', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().access_token;",
                  "pm.collectionVariables.set('tenantToken', token);",
                  "const encoded = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "const payload = JSON.parse(atob(encoded.padEnd(Math.ceil(encoded.length / 4) * 4, '=')));",
                  "pm.collectionVariables.set('tenantSubject', payload.sub);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Platform onboarding",
      "item": [
        {
          "name": "List platform permissions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/platform/permissions"
          }
        },
        {
          "name": "Register tenant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-tenant-create-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Acceptance Hotel Group\",\n  \"slug\": \"postman-acceptance-group\",\n  \"planId\": \"{{planId}}\",\n  \"legalName\": \"Postman Acceptance Hotel Group Limited\",\n  \"tradingName\": \"Postman Acceptance\",\n  \"entityType\": \"limited_company\",\n  \"businessRegistrationNumber\": \"POSTMAN-P2-001\",\n  \"businessEmail\": \"business.postman@example.com\",\n  \"businessPhone\": \"+255712300001\",\n  \"registeredAddress\": {\"line1\": \"Peak Road\", \"city\": \"Dar es Salaam\", \"countryCode\": \"TZ\"},\n  \"countryCode\": \"TZ\",\n  \"currencyCode\": \"TZS\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/platform/tenants"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('tenant created', () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "pm.collectionVariables.set('tenantId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Provision tenant administrator",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-tenant-admin-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Tenant Administrator\",\n  \"email\": \"phase2.tenant@example.com\",\n  \"issuer\": \"http://keycloak:8080/realms/peak\",\n  \"subject\": \"{{tenantSubject}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/platform/tenants/{{tenantId}}/administrators"
          }
        },
        {
          "name": "Verify tenant profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-profile-verify-001" }
            ],
            "url": "{{baseUrl}}/api/v1/platform/tenants/{{tenantId}}/profile/verify"
          }
        }
      ]
    },
    {
      "name": "03 Tenant and property setup",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{tenantToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Enable tenant property module",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-module-property-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"moduleId\":\"property\"}"
            },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Enable tenant communications module",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-module-communications-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"communications\"}" },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Enable tenant realtime module",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-module-realtime-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"realtime\"}" },
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/modules"
          }
        },
        {
          "name": "Create property",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-property-create-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman Acceptance Hotel\",\"location\":\"Dar es Salaam\",\"code\":\"PMA001\",\"type\":\"HOTEL\"}"
            },
            "url": "{{baseUrl}}/api/v1/properties"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('property created', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('propertyId', pm.response.json().propertyId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Enable property core module",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-property-module-core-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"property\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/modules"
          }
        },
        {
          "name": "Enable property realtime module",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-property-module-realtime-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"moduleId\":\"realtime\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/modules"
          }
        },
        {
          "name": "Create building",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-building-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Main Building\",\"description\":\"Postman acceptance\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/buildings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('buildingId', pm.response.json().resourceId);"]
              }
            }
          ]
        },
        {
          "name": "Create floor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-floor-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"buildingId\":\"{{buildingId}}\",\"floorNumber\":1,\"name\":\"Ground Floor\",\"capacity\":20}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/floors"
          }
        },
        {
          "name": "Create room type",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-room-type-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Deluxe King\",\"code\":\"DLX\",\"basePrice\":0,\"maxAdults\":2,\"maxChildren\":1,\"maxOccupancy\":3}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/room-types"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('roomTypeId', pm.response.json().resourceId);"]
              }
            }
          ]
        },
        {
          "name": "Create room",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-room-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"buildingId\":\"{{buildingId}}\",\"roomNumber\":\"101\",\"roomTypeId\":\"{{roomTypeId}}\",\"floorNumber\":1}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/rooms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('roomId', pm.response.json().resourceId);"]
              }
            }
          ]
        },
        {
          "name": "Create revenue center",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-revenue-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Rooms Revenue\",\"code\":\"ROOMS\",\"centerType\":\"rooms\",\"isRoomsRevenue\":true,\"displayOrder\":10}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/revenue-centers"
          }
        },
        {
          "name": "Create VAT",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-tax-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"Value Added Tax\",\"code\":\"VAT18\",\"rate\":0.18,\"taxType\":\"VAT\",\"isCompound\":false,\"isInclusive\":true}" },
            "url": "{{baseUrl}}/api/v1/properties/taxes"
          }
        },
        {
          "name": "Create base rate",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-rate-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"roomTypeId\":\"{{roomTypeId}}\",\"amount\":175000,\"currency\":\"TZS\"}" },
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/rates"
          }
        }
      ]
    },
    {
      "name": "04 Communications and readiness",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{tenantToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Create business contact",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-contact-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"fullName\":\"Postman Managing Director\",\"jobTitle\":\"Managing Director\",\"email\":\"{{contactEmail}}\"}" },
            "url": "{{baseUrl}}/api/v1/communication/contacts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('contactId', body.contactId);",
                  "pm.collectionVariables.set('channelId', body.channelIds[0]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Request channel verification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-channel-request-001" }
            ],
            "url": "{{baseUrl}}/api/v1/communication/channels/{{channelId}}/request-verification"
          }
        },
        {
          "name": "Verify channel",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-channel-verify-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"token\":\"{{verificationToken}}\"}" },
            "url": "{{baseUrl}}/api/v1/communication/channels/{{channelId}}/verify"
          }
        },
        {
          "name": "Assign owner role",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-contact-role-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"roleCode\":\"owner_managing_director\",\"primary\":true}" },
            "url": "{{baseUrl}}/api/v1/communication/contacts/{{contactId}}/roles"
          }
        },
        {
          "name": "Record report consent",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-consent-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"purpose\":\"operational_reports\",\"policyVersion\":\"phase2-v1\",\"status\":\"active\"}" },
            "url": "{{baseUrl}}/api/v1/communication/contacts/{{contactId}}/channels/{{channelId}}/consents"
          }
        },
        {
          "name": "Configure report recipient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-report-recipient-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"contactId\":\"{{contactId}}\",\"channelId\":\"{{channelId}}\",\"reportCode\":\"monthly_executive_summary\",\"subscriptionName\":\"Executive Management Pack\",\"frequency\":\"monthly\",\"timezone\":\"Africa/Dar_es_Salaam\",\"deliveryFormat\":\"pdf\"}" },
            "url": "{{baseUrl}}/api/v1/communication/report-recipients"
          }
        },
        {
          "name": "Property readiness",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/readiness"
          }
        },
        {
          "name": "Activate property",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-property-activate-001" }
            ],
            "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/activate"
          }
        },
        {
          "name": "Tenant readiness",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/readiness"
          }
        },
        {
          "name": "Send notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" },
              { "key": "Idempotency-Key", "value": "postman-notification-001" }
            ],
            "body": { "mode": "raw", "raw": "{\"propertyId\":\"{{propertyId}}\",\"channel\":\"EMAIL\",\"recipient\":\"{{contactEmail}}\",\"subject\":\"Foundation acceptance\",\"content\":\"Peak delivery accepted.\"}" },
            "url": "{{baseUrl}}/api/v1/communication/notifications"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.collectionVariables.set('deliveryRequestId', pm.response.json().deliveryRequestId);"]
              }
            }
          ]
        },
        {
          "name": "Get delivery status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/communication/delivery-requests/{{deliveryRequestId}}"
          }
        }
      ]
    },
    {
      "name": "05 Realtime and boundaries",
      "auth": {
        "type": "bearer",
        "bearer": [
          { "key": "token", "value": "{{tenantToken}}", "type": "string" }
        ]
      },
      "item": [
        {
          "name": "Open SSE stream",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/event-stream" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/realtime/tenants/{{tenantId}}/properties/{{propertyId}}/stream"
          }
        },
        {
          "name": "Tenant denied from platform route",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/api/v1/platform/permissions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('cross-scope request denied', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        }
      ]
    }
  ]
}
