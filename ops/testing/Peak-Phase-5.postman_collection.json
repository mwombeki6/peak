{
  "info": {
    "_postman_id": "8d3552e6-a92a-45bf-b8f4-0051d6fd5005",
    "name": "Peak Phase 5 - Control Close Reporting",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "tenantId", "value": "" },
    { "key": "propertyId", "value": "" },
    { "key": "nightAuditRunId", "value": "" },
    { "key": "dailyReportRunId", "value": "" }
  ],
  "item": [
    {
      "name": "Catalog exposes only two core generators",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Correlation-Id", "value": "phase5-catalog" }
        ],
        "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/reports/catalog"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('catalog is available', () => pm.response.to.have.status(200));",
              "const generated = pm.response.json().filter(x => x.generatorAvailable).map(x => x.reportCode).sort();",
              "pm.test('core generators are exact', () => pm.expect(generated).to.eql(['daily_management_summary','night_audit_close']));"
            ]
          }
        }
      ]
    },
    {
      "name": "Close snapshot is immutable evidence",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Correlation-Id", "value": "phase5-snapshot" }
        ],
        "url": "{{baseUrl}}/api/v1/properties/{{propertyId}}/night-audit/{{nightAuditRunId}}/close-snapshot"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('snapshot is available', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('snapshot hash is SHA-256', () => pm.expect(body.payloadHash).to.match(/^[0-9a-f]{64}$/));",
              "pm.test('ratios have values', () => { pm.expect(body).to.have.property('occupancy'); pm.expect(body).to.have.property('adr'); pm.expect(body).to.have.property('revpar'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Both core report artifacts generated",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Correlation-Id", "value": "phase5-runs" }
        ],
        "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/report-runs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('runs are available', () => pm.response.to.have.status(200));",
              "const runs = pm.response.json();",
              "const generated = runs.filter(x => x.state === 'GENERATED').map(x => x.reportCode);",
              "pm.test('daily report generated', () => pm.expect(generated).to.include('daily_management_summary'));",
              "pm.test('close report generated', () => pm.expect(generated).to.include('night_audit_close'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Daily report delivery history",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-Correlation-Id", "value": "phase5-deliveries" }
        ],
        "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/report-runs/{{dailyReportRunId}}/deliveries"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('delivery history is available', () => pm.response.to.have.status(200));",
              "const deliveries = pm.response.json();",
              "pm.test('recipient is masked', () => pm.expect(deliveries.every(x => !x.destinationMasked.includes('@') || x.destinationMasked.includes('*'))).to.eql(true));",
              "pm.test('daily link was sent', () => pm.expect(deliveries.some(x => ['SENT','DELIVERED'].includes(x.state))).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "Authenticated download link expires",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Correlation-Id", "value": "phase5-download" }
        ],
        "url": "{{baseUrl}}/api/v1/tenants/{{tenantId}}/report-runs/{{dailyReportRunId}}/download-link"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('download link is available', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('link is signed and short lived', () => { pm.expect(body.url).to.match(/^http/); const ttl = new Date(body.expiresAt).getTime() - Date.now(); pm.expect(ttl).to.be.above(13 * 60 * 1000); pm.expect(ttl).to.be.below(16 * 60 * 1000); });"
            ]
          }
        }
      ]
    }
  ]
}
