{
  "name": "@peak/api-clients",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0"
  },
  "scripts": {
    "generate:specs": "node scripts/split-openapi.mjs",
    "generate:clients": "npm run generate --workspaces --if-present",
    "generate": "npm run generate:specs && npm run generate:clients",
    "verify:boundaries": "node scripts/verify-client-boundaries.mjs",
    "lint:openapi": "redocly lint contracts/platform-v1.json contracts/hospitality-v1.json --config redocly.yaml",
    "audit:dependencies": "npm audit --audit-level=high",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "pack:clients": "node scripts/pack-clients.mjs",
    "check": "npm run generate && npm run verify:boundaries && npm run lint:openapi && npm run audit:dependencies && npm run typecheck && npm run build && npm run pack:clients"
  },
  "devDependencies": {
    "@redocly/cli": "2.41.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
